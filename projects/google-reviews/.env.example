# Copy to .env and fill in. Never commit .env.

BUSINESS_NAME=Your Paint Shop
# Find yours: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=
REVIEWBOT_DB=reviewbot.db

# Cadence
REQUEST_DELAY_DAYS=1
REMINDER_AFTER_DAYS=5
MAX_REQUESTS_PER_RUN=50

# Email (Google Workspace, Microsoft 365, SendGrid SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
LOW_STAR_THRESHOLD=3

# Optional SMS via Twilio (only customers who consented to texts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Google Business Profile API (needed for sync / replies)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=

# Claude reply drafting (uv sync --extra ai)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
REPLY_TONE=warm, professional, concise; sign off as the team

# DRY_RUN=1
