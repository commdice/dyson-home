# Copy to .env on the NAS and fill in. Never commit .env.
BRAIN_TOKEN=change-me-to-a-long-random-string
BRAIN_PORT=7777
# The address your PCs use to reach the NAS (written into /openapi.json)
BRAIN_PUBLIC_URL=http://nas.local:7777
# Folder on the NAS that holds the memories (back this up / snapshot it)
VAULT_DIR=/volume1/SecondBrain
# NAS user/group that owns VAULT_DIR
PUID=1026
PGID=100
TZ=America/New_York

# --- Semantic search (Ollama) ---
# Folder for Ollama's downloaded models (no need to back this up)
OLLAMA_DIR=/volume1/docker/second-brain/ollama
# Embedding model. nomic-embed-text: ~270 MB, fast on NAS CPUs, English. Alternatives:
#   bge-m3 (~1.2 GB, multilingual), mxbai-embed-large (~670 MB, more accurate), embeddinggemma (~620 MB)
BRAIN_EMBED_MODEL=nomic-embed-text
# Uncomment to use an Ollama you already run elsewhere (then delete the ollama service in docker-compose.yml)
# OLLAMA_URL=http://192.168.1.50:11434
# Uncomment (empty value) to turn semantic search off entirely
# OLLAMA_URL=
