# Copy to .env on the NAS and fill in. Never commit .env.
BRAIN_TOKEN=change-me-to-a-long-random-string
BRAIN_PORT=7777
# The address your PCs use to reach the NAS (written into /openapi.json)
BRAIN_PUBLIC_URL=http://nas.local:7777
# Folder on the NAS that holds the memories (back this up / snapshot it)
VAULT_DIR=/volume1/SecondBrain
# NAS user/group that owns VAULT_DIR
PUID=1026
PGID=100
TZ=America/New_York
