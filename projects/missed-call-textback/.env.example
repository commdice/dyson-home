# Copy to .env and fill in.  cp .env.example .env

# --- Server ---
PORT=3000
# Public HTTPS address Twilio can reach (your domain, or an ngrok/Cloudflare tunnel URL while testing)
PUBLIC_BASE_URL=https://textback.yourshop.com

# --- Twilio (console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# The Twilio number customers call (E.164 format)
TWILIO_PHONE_NUMBER=+15555550100
# Optional but needed for US texting at volume (A2P 10DLC). Leave blank to send straight from the number.
TWILIO_MESSAGING_SERVICE_SID=
# Leave true in production. Set false only for local curl testing.
TWILIO_VALIDATE_SIGNATURES=true

# --- Your business ---
BUSINESS_NAME=Acme Paint & Supply
# The real phone(s) that should ring. Comma-separate to ring several at once (first to pick up wins).
FORWARD_TO=+15555550111
# Ring this many seconds before treating the call as missed.
# Keep it SHORTER than the time it takes that phone's own voicemail to pick up.
RING_SECONDS=20
# Cell phones that get a copy of customer text replies (comma-separated)
NOTIFY_NUMBERS=+15555550122
TIMEZONE=America/New_York
# Days: sun mon tue wed thu fri sat. Ranges and lists ok. Separate entries with ;
BUSINESS_HOURS=mon-fri 07:00-17:30; sat 08:00-14:00

# --- Text back behavior ---
# Don't text the same number again within this many hours
COOLDOWN_HOURS=12
# {business} is replaced with BUSINESS_NAME. Leave blank to use the defaults.
MISSED_MESSAGE=
AFTER_HOURS_MESSAGE=
MISSED_GREETING=
AFTER_HOURS_GREETING=

# --- Dashboard at /admin (disabled until a password is set) ---
ADMIN_USER=admin
ADMIN_PASSWORD=

DB_PATH=data/textback.db
