<?xml version="1.0" encoding="utf-8"?>
<!--
  Stardate Ops - an LCARS-inspired digital watch face.
  Watch Face Format (WFF) v1. Canvas is 450x450 and scales to the
  Galaxy Watch 7 40mm (432px) and 44mm (480px) screens.

  Theme colour slots ([CONFIGURATION.theme.N]):
    0 = primary (elbows, stardate)   1 = secondary (lavender bars)
    2 = tertiary (blue bars)         3 = accent (time, readouts)
    4 = alert (bottom bar)
-->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="DIGITAL" />
  <Metadata key="PREVIEW_TIME" value="10:08:32" />

  <UserConfigurations>
    <ColorConfiguration id="theme" displayName="theme_label" defaultValue="0">
      <ColorOption id="0" displayName="theme_classic"
          colors="#FFFF9900 #FFCC99CC #FF9999FF #FFFFCC99 #FFCC6666" />
      <ColorOption id="1" displayName="theme_blue_alert"
          colors="#FF5599FF #FF99CCFF #FF3366CC #FFCCE6FF #FF6688CC" />
      <ColorOption id="2" displayName="theme_red_alert"
          colors="#FFFF3333 #FFFF9966 #FFCC3333 #FFFFCCCC #FFFF6666" />
      <ColorOption id="3" displayName="theme_engineering"
          colors="#FFFFAA00 #FFFFDD55 #FFCC7722 #FFFFEEBB #FFDD8844" />
    </ColorConfiguration>
    <BooleanConfiguration id="showSeconds" displayName="seconds_label" defaultValue="TRUE" />
    <ListConfiguration id="clockFormat" displayName="clock_label" defaultValue="0">
      <ListOption id="0" displayName="clock_12" />
      <ListOption id="1" displayName="clock_24" />
    </ListConfiguration>
  </UserConfigurations>

  <Scene backgroundColor="#FF000000">

    <!-- ========== LCARS FRAME (hidden in always-on mode) ========== -->
    <Group name="frame" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <!-- Top-left elbow -->
      <PartDraw x="0" y="0" width="450" height="450">
        <RoundRectangle x="60" y="100" width="100" height="80" cornerRadiusX="30" cornerRadiusY="30">
          <Fill color="[CONFIGURATION.theme.0]" />
        </RoundRectangle>
        <Rectangle x="90" y="100" width="70" height="18">
          <Fill color="[CONFIGURATION.theme.0]" />
        </Rectangle>
        <Rectangle x="60" y="150" width="40" height="30">
          <Fill color="[CONFIGURATION.theme.0]" />
        </Rectangle>
        <!-- Inner curve cut-out -->
        <RoundRectangle x="100" y="118" width="120" height="100" cornerRadiusX="16" cornerRadiusY="16">
          <Fill color="#FF000000" />
        </RoundRectangle>
      </PartDraw>

      <!-- Bottom-left elbow -->
      <PartDraw x="0" y="0" width="450" height="450">
        <RoundRectangle x="60" y="270" width="100" height="80" cornerRadiusX="30" cornerRadiusY="30">
          <Fill color="[CONFIGURATION.theme.0]" />
        </RoundRectangle>
        <Rectangle x="60" y="270" width="40" height="30">
          <Fill color="[CONFIGURATION.theme.0]" />
        </Rectangle>
        <Rectangle x="90" y="332" width="70" height="18">
          <Fill color="[CONFIGURATION.theme.0]" />
        </Rectangle>
        <RoundRectangle x="100" y="232" width="120" height="100" cornerRadiusX="16" cornerRadiusY="16">
          <Fill color="#FF000000" />
        </RoundRectangle>
      </PartDraw>

      <!-- Left column segments -->
      <PartDraw x="0" y="0" width="450" height="450">
        <Rectangle x="60" y="184" width="40" height="42">
          <Fill color="[CONFIGURATION.theme.1]" />
        </Rectangle>
        <Rectangle x="60" y="230" width="40" height="36">
          <Fill color="[CONFIGURATION.theme.2]" />
        </Rectangle>
      </PartDraw>

      <!-- Top bar segments -->
      <PartDraw x="0" y="0" width="450" height="450">
        <Rectangle x="164" y="100" width="86" height="18">
          <Fill color="[CONFIGURATION.theme.1]" />
        </Rectangle>
        <Rectangle x="254" y="100" width="76" height="18">
          <Fill color="[CONFIGURATION.theme.2]" />
        </Rectangle>
        <RoundRectangle x="334" y="100" width="40" height="18" cornerRadiusX="9" cornerRadiusY="9">
          <Fill color="[CONFIGURATION.theme.3]" />
        </RoundRectangle>
        <Rectangle x="334" y="100" width="20" height="18">
          <Fill color="[CONFIGURATION.theme.3]" />
        </Rectangle>
      </PartDraw>

      <!-- Bottom bar segments -->
      <PartDraw x="0" y="0" width="450" height="450">
        <Rectangle x="164" y="332" width="76" height="18">
          <Fill color="[CONFIGURATION.theme.4]" />
        </Rectangle>
        <Rectangle x="244" y="332" width="86" height="18">
          <Fill color="[CONFIGURATION.theme.1]" />
        </Rectangle>
        <RoundRectangle x="334" y="332" width="40" height="18" cornerRadiusX="9" cornerRadiusY="9">
          <Fill color="[CONFIGURATION.theme.0]" />
        </RoundRectangle>
        <Rectangle x="334" y="332" width="20" height="18">
          <Fill color="[CONFIGURATION.theme.0]" />
        </Rectangle>
      </PartDraw>

      <!-- Decorative register numbers on the left column -->
      <PartText x="62" y="204" width="34" height="20">
        <Text align="END">
          <Font size="14" weight="BOLD" color="#FF000000">
            <Template>03</Template>
          </Font>
        </Text>
      </PartText>
      <PartText x="62" y="246" width="34" height="20">
        <Text align="END">
          <Font size="14" weight="BOLD" color="#FF000000">
            <Template>47</Template>
          </Font>
        </Text>
      </PartText>
      <PartText x="62" y="150" width="34" height="20">
        <Text align="END">
          <Font size="14" weight="BOLD" color="#FF000000">
            <Template>OPS</Template>
          </Font>
        </Text>
      </PartText>
    </Group>

    <!-- ========== DATE (top) ========== -->
    <PartText x="80" y="58" width="290" height="36">
      <Variant mode="AMBIENT" target="alpha" value="170" />
      <Text align="CENTER">
        <Font size="26" weight="BOLD" color="[CONFIGURATION.theme.0]">
          <Template>%s  %s %s<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY]" /><Parameter expression="[MONTH_S]" /></Template>
        </Font>
      </Text>
    </PartText>

    <!-- ========== TIME ========== -->
    <!-- Drawn as plain text: DigitalClock did not render on Galaxy Watch 7. -->
    <ListConfiguration id="clockFormat">
      <ListOption id="0">
        <PartText x="112" y="118" width="232" height="86">
          <Text align="CENTER">
            <Font size="70" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>%s:%s<Parameter expression="[HOUR_1_12]" /><Parameter expression="[MINUTE_Z]" /></Template></Font>
          </Text>
        </PartText>
      </ListOption>
      <ListOption id="1">
        <PartText x="112" y="118" width="232" height="86">
          <Text align="CENTER">
            <Font size="70" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>%s:%s<Parameter expression="[HOUR_0_23_Z]" /><Parameter expression="[MINUTE_Z]" /></Template></Font>
          </Text>
        </PartText>
      </ListOption>
    </ListConfiguration>

    <BooleanConfiguration id="showSeconds">
      <BooleanOption id="TRUE">
        <PartText x="334" y="146" width="50" height="34">
          <Variant mode="AMBIENT" target="alpha" value="0" />
          <Text align="START">
            <Font size="26" weight="BOLD" color="[CONFIGURATION.theme.0]"><Template>%s<Parameter expression="[SECOND_Z]" /></Template></Font>
          </Text>
        </PartText>
      </BooleanOption>
    </BooleanConfiguration>

    <!-- ========== READOUTS (hidden in always-on mode) ==========
         Row 1: built-in sensors. Row 2: complication slots the wearer picks
         (long-press > Customise > Complications). Tapping a slot opens its app. -->
    <Group name="readouts" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0" />

      <PartDraw x="0" y="0" width="450" height="450">
        <RoundRectangle x="112" y="206" width="82" height="18" cornerRadiusX="9" cornerRadiusY="9">
          <Fill color="[CONFIGURATION.theme.0]" />
        </RoundRectangle>
        <RoundRectangle x="200" y="206" width="88" height="18" cornerRadiusX="9" cornerRadiusY="9">
          <Fill color="[CONFIGURATION.theme.1]" />
        </RoundRectangle>
        <RoundRectangle x="294" y="206" width="82" height="18" cornerRadiusX="9" cornerRadiusY="9">
          <Fill color="[CONFIGURATION.theme.2]" />
        </RoundRectangle>
        <RoundRectangle x="112" y="262" width="82" height="18" cornerRadiusX="9" cornerRadiusY="9">
          <Fill color="[CONFIGURATION.theme.2]" />
        </RoundRectangle>
        <RoundRectangle x="200" y="262" width="88" height="18" cornerRadiusX="9" cornerRadiusY="9">
          <Fill color="[CONFIGURATION.theme.0]" />
        </RoundRectangle>
        <RoundRectangle x="294" y="262" width="82" height="18" cornerRadiusX="9" cornerRadiusY="9">
          <Fill color="[CONFIGURATION.theme.1]" />
        </RoundRectangle>
      </PartDraw>
      <PartText x="112" y="206" width="82" height="18">
          <Text align="CENTER">
            <Font size="13" weight="BOLD" color="#FF000000"><Template>POWER</Template></Font>
          </Text>
        </PartText>
      <PartText x="200" y="206" width="88" height="18">
          <Text align="CENTER">
            <Font size="13" weight="BOLD" color="#FF000000"><Template>STEPS</Template></Font>
          </Text>
        </PartText>
      <PartText x="294" y="206" width="82" height="18">
          <Text align="CENTER">
            <Font size="13" weight="BOLD" color="#FF000000"><Template>BIO</Template></Font>
          </Text>
        </PartText>
      <PartText x="112" y="262" width="82" height="18">
          <Text align="CENTER">
            <Font size="13" weight="BOLD" color="#FF000000"><Template>ATMOS</Template></Font>
          </Text>
        </PartText>
      <PartText x="200" y="262" width="88" height="18">
          <Text align="CENTER">
            <Font size="13" weight="BOLD" color="#FF000000"><Template>COMMS</Template></Font>
          </Text>
        </PartText>
      <PartText x="294" y="262" width="82" height="18">
          <Text align="CENTER">
            <Font size="13" weight="BOLD" color="#FF000000"><Template>ALT</Template></Font>
          </Text>
        </PartText>

      <!-- Row 1 values -->
      <PartText x="108" y="225" width="90" height="30">
          <Text align="CENTER">
            <Font size="24" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>%s%%<Parameter expression="[BATTERY_PERCENT]" /></Template></Font>
          </Text>
        </PartText>
      <PartText x="196" y="225" width="96" height="30">
          <Text align="CENTER">
            <Font size="24" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>%s<Parameter expression="[STEP_COUNT]" /></Template></Font>
          </Text>
        </PartText>
      <PartText x="306" y="225" width="74" height="30">
          <Text align="CENTER">
            <Font size="24" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>%s<Parameter expression="[HEART_RATE]" /></Template></Font>
          </Text>
        </PartText>

      <!-- Heartbeat: a dot that flashes once per beat at the measured heart rate -->
      <PartDraw x="0" y="0" width="450" height="450">
        <Transform target="alpha" value="255 - (([SECOND_MILLISECOND] * [HEART_RATE] / 60) % 1) * 255" />
        <Ellipse x="298" y="234" width="12" height="12">
          <Fill color="[CONFIGURATION.theme.4]" />
        </Ellipse>
      </PartDraw>

      <!-- Row 2: complication slots -->
      <ComplicationSlot slotId="0" displayName="slot_atmos" x="112" y="262" width="82" height="49"
          supportedTypes="SHORT_TEXT RANGED_VALUE" isCustomizable="TRUE">
        <DefaultProviderPolicy defaultSystemProvider="SUNRISE_SUNSET" defaultSystemProviderType="SHORT_TEXT" />
        <BoundingBox x="0" y="0" width="82" height="49" />
        <Complication type="SHORT_TEXT">
          <PartText x="0" y="19" width="82" height="30">
          <Text align="CENTER">
            <Font size="24" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font>
          </Text>
        </PartText>
        </Complication>
        <Complication type="RANGED_VALUE">
          <PartText x="0" y="19" width="82" height="30">
          <Text align="CENTER">
            <Font size="24" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font>
          </Text>
        </PartText>
        </Complication>
        <Complication type="EMPTY">
          <PartText x="0" y="19" width="82" height="30">
          <Text align="CENTER">
            <Font size="24" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>--</Template></Font>
          </Text>
        </PartText>
        </Complication>
      </ComplicationSlot>
      <ComplicationSlot slotId="1" displayName="slot_comms" x="200" y="262" width="88" height="49"
          supportedTypes="SHORT_TEXT RANGED_VALUE" isCustomizable="TRUE">
        <DefaultProviderPolicy defaultSystemProvider="UNREAD_NOTIFICATION_COUNT" defaultSystemProviderType="SHORT_TEXT" />
        <BoundingBox x="0" y="0" width="88" height="49" />
        <Complication type="SHORT_TEXT">
          <PartText x="0" y="19" width="88" height="30">
          <Text align="CENTER">
            <Font size="24" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font>
          </Text>
        </PartText>
        </Complication>
        <Complication type="RANGED_VALUE">
          <PartText x="0" y="19" width="88" height="30">
          <Text align="CENTER">
            <Font size="24" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font>
          </Text>
        </PartText>
        </Complication>
        <Complication type="EMPTY">
          <PartText x="0" y="19" width="88" height="30">
          <Text align="CENTER">
            <Font size="24" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>--</Template></Font>
          </Text>
        </PartText>
        </Complication>
      </ComplicationSlot>
      <ComplicationSlot slotId="2" displayName="slot_alt" x="294" y="262" width="82" height="49"
          supportedTypes="SHORT_TEXT RANGED_VALUE" isCustomizable="TRUE">
        <DefaultProviderPolicy defaultSystemProvider="NEXT_EVENT" defaultSystemProviderType="SHORT_TEXT" />
        <BoundingBox x="0" y="0" width="82" height="49" />
        <Complication type="SHORT_TEXT">
          <PartText x="0" y="19" width="82" height="30">
          <Text align="CENTER">
            <Font size="24" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font>
          </Text>
        </PartText>
        </Complication>
        <Complication type="RANGED_VALUE">
          <PartText x="0" y="19" width="82" height="30">
          <Text align="CENTER">
            <Font size="24" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font>
          </Text>
        </PartText>
        </Complication>
        <Complication type="EMPTY">
          <PartText x="0" y="19" width="82" height="30">
          <Text align="CENTER">
            <Font size="24" weight="BOLD" color="[CONFIGURATION.theme.3]"><Template>--</Template></Font>
          </Text>
        </PartText>
        </Complication>
      </ComplicationSlot>
    </Group>

    <!-- ========== STARDATE (bottom) ==========
         Fan-style stardate: (year - 2000) * 1000 + fraction of year, plus a
         tenths digit that ticks through the day. 14 Nov 2026 10:00 = 26868.4 -->
    <PartText x="70" y="356" width="310" height="32">
      <Variant mode="AMBIENT" target="alpha" value="170" />
      <Text align="CENTER">
        <Font size="22" weight="BOLD" color="[CONFIGURATION.theme.0]">
          <Template>STARDATE %s<Parameter expression="floor((([YEAR] - 2000) * 1000 + ([DAY_OF_YEAR] - 1 + [HOUR_0_23] / 24) * 1000 / 366) * 10) / 10" /></Template>
        </Font>
      </Text>
    </PartText>

  </Scene>
</WatchFace>
